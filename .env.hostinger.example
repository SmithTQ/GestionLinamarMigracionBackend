APP_NAME="Gestor de Pedidos Linamar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.nicolaetincoquispe.com
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
FRONTEND_URL=https://DOMINIO_REAL_DEL_FRONTEND

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=HOST_DE_BASE_DE_DATOS
DB_PORT=3306
DB_DATABASE=BASE_DE_DATOS_HOSTINGER
DB_USERNAME=USUARIO_HOSTINGER
DB_PASSWORD=CONTRASENA_HOSTINGER

FILESYSTEM_DISK=local
PRODUCT_IMAGE_DISK=public
FORMS_FILE_DISK=local
FORMS_FILE_MAX_SIZE_KB=5120

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file

L5_SWAGGER_GENERATE_ALWAYS=false

# Solo si se usa la importacion de Google Sheets.
GOOGLE_APPLICATION_CREDENTIALS=/home/USUARIO/apps/linamar-backend/storage/app/private/google-credentials.json
